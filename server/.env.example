# ── Accounts / premium (see SETUP-ACCOUNTS.md) ─────────────────────────────
# From Supabase: Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: Stripe webhook signing secret for instant premium activation
# (Stripe Dashboard → Developers → Webhooks → endpoint for /api/account/stripe-webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: premium price override (defaults: 500 cents, usd)
# PREMIUM_PRICE_CENTS=500
# PREMIUM_CURRENCY=usd
