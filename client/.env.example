# Accounts / premium (see SETUP-ACCOUNTS.md).
# From Supabase: Project Settings → API. The anon key is safe to expose.
# Without these two vars, all account UI is hidden and the site works as before.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: point the client at a different API host (defaults to /api)
# VITE_API_BASE=/api
